<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /auth/

  # Hostinger redirects /auth/login.php -> /auth/login; map back to PHP handlers
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
