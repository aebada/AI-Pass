# Stub mode returns deterministic demo results (no LLM API keys required)
DEEPTEAM_STUB_MODE=1

# Protect /security/* endpoints
DEEPTEAM_SERVICE_API_KEY=

DEEPTEAM_HOST=0.0.0.0
DEEPTEAM_PORT=8200

# Judge / attack-simulation LLM (required when DEEPTEAM_STUB_MODE=0)
OPENAI_API_KEY=
# Optional Confident AI cloud (results sync) — not required for local runs
# CONFIDENT_API_KEY=

# Default target when scan request omits targetUrl (AI-Pass probe route)
DEEPTEAM_DEFAULT_TARGET_URL=http://127.0.0.1:3000/api/governance/security/probe
