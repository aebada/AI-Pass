# Copy to auth-lib/.env on the server (NEVER commit real secrets).
# Hostinger path: domains/aipass.space/public_html/auth-lib/.env
# Protected by auth-lib/.htaccess (Require all denied).

APP_URL=https://aipass.space
APP_ENV=production

# MySQL (Hostinger hPanel → Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u234903558_aipass
DB_USER=u234903558_aipass
DB_PASS=your-database-password

# Google OAuth — project aipass-501004
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://aipass.space/auth/google-callback.php

# Session hardening (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Post-login redirect (static Next export workspace)
LOGIN_SUCCESS_URL=/workspace
