APP_NAME="AI-Pass Auth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://aipass.space

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Hostinger MySQL (hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=AIPASS_SESSION
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Hostinger Email SMTP (hPanel → Emails → info@aipass.space → Connect Apps)
# Required for password-reset + verification emails. Never use log/array in production.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@aipass.space
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@aipass.space"
MAIL_FROM_NAME="AI-Pass"

# Google OAuth (project aipass-501004) — set secrets on server only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aipass.space/auth/google/callback

# Post-login redirect for static Next.js workspace
LOGIN_SUCCESS_URL=/workspace

VITE_APP_NAME="${APP_NAME}"

# AI provider keys (server-only — required for live playground + twin chat)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=
XAI_GROK_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
KIMI_API_KEY=
KIMI_API_ID=
# Optional override (default https://api.moonshot.ai/v1 ; China: https://api.moonshot.cn/v1)
KIMI_BASE_URL=

# Free tier limits (playground)
FREE_MONTHLY_CREDITS=500
FREE_DAILY_REQUESTS=20

# --- External ecosystem integrations (server-side only) ---
# Called from IntegrationsController. Each key must match AIPASS_API_KEY on the
# corresponding deployment. Leave a key blank to keep that integration
# read-blocked: /health still reports liveness, data endpoints return 503.
INVOICE_AI_URL=https://invoice.ehopn.com
INVOICE_AI_API_KEY=
CARBON_URL=https://carbon.ehopn.com
CARBON_API_KEY=
SOVRA_AI_URL=https://sovraai.de
SOVRA_AI_API_KEY=
INTEGRATIONS_TIMEOUT=8
