# AI Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Web app (client-exposed prefix for browser-side agent calls)
NEXT_PUBLIC_OPENAI_API_KEY=

# Desktop dev: override web URL if needed
WEB_URL=http://localhost:3000

# Optional: OpenAI-compatible endpoint (Ollama, LM Studio, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama

# Backend database (docker-compose provides this locally)
DATABASE_URL=postgresql://aipass:aipass@localhost:5432/aipass_dev

# Auth service
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google sign-in (optional; sign-in falls back to email and password without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
