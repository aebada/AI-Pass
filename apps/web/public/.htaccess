# Hostinger / Apache — Next.js static export routing
<IfModule mod_rewrite.c>
  RewriteEngine On

# --- Node.js API proxy (Google / NextAuth) ---
# Merge docs/apache-api-proxy.htaccess into public_html/.htaccess BEFORE the SPA fallback.
# Requires mod_proxy on Hostinger. See docs/DEPLOY-AUTH.md.

  RewriteBase /

  # Existing files (incl. _next assets)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # platform.html vs platform/ directory — serve the page, not the folder
  RewriteRule ^platform/?$ /platform.html [L]

  # Clean URLs: /studio -> studio.html, /platform/governance -> platform/governance.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Nested .html when path is a directory (e.g. platform/governance)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Never SPA-fallback hashed Next assets — missing files must 404 (not index.html),
  # otherwise CDNs cache HTML as CSS/JS and break the whole site theme.
  RewriteRule ^_next/ - [L,R=404]

  # Fallback SPA shell
  RewriteRule ^ /index.html [L]
</IfModule>

# HTML must not be cached by CDN — otherwise stale shells keep pointing at poisoned CSS hashes
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
  # During recovery: shorter CSS cache so a bad edge entry expires faster
  <FilesMatch "\.(css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
