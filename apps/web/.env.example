# Platform-managed keys (server only — never use NEXT_PUBLIC_*)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=
XAI_GROK_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
ANTHROPIC_API_KEY=

# Auth (Google OAuth — see docs/AUTH.md; project e.g. aipass-501004)
# Static Hostinger deploy uses Laravel auth — see docs/LARAVEL-AUTH.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: http://localhost:3000 | Prod: https://aipass.space
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Set to 1 automatically by scripts/build-web-static.sh (Laravel auth on Hostinger)
# NEXT_PUBLIC_USE_LARAVEL_AUTH=1
# Optional when Laravel auth runs on a subdomain: https://auth.aipass.space
# NEXT_PUBLIC_AUTH_API_URL=

# Free tier limits
FREE_MONTHLY_CREDITS=500
FREE_DAILY_REQUESTS=20
