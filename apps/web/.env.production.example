# Production server environment (Hostinger Node.js / VPS)
# Copy to hPanel → Node.js → Environment variables, or to .env on the server.
# NEVER commit real secrets — use Hostinger env UI or a local-only .env.production.

# Google OAuth (project aipass-501004)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js / NextAuth
NEXTAUTH_URL=https://aipass.space
NEXTAUTH_SECRET=

# Node listen port (Hostinger sets PORT automatically; default 3000 for VPS/PM2)
PORT=3000

# Optional: platform AI keys (server-only routes)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
