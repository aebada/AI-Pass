# AI-Pass Backend API — environment configuration template.
# Copy to .env.<environment> (development|staging|production) and fill in real
# values for that environment. Real .env.* files are gitignored — never commit them.
#
# The active environment is chosen via the APP_ENV system variable (falls back
# to ENVIRONMENT, then defaults to "development"). See app/config.py.

APP_ENV=development
APP_NAME=AI-Pass Backend API
DEBUG=true

HOST=0.0.0.0
PORT=8001

LOG_LEVEL=info

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLAlchemy-style connection string
DATABASE_URL=sqlite:///./dev.db

# Signs tokens/sessions — generate a unique value per environment, never reuse dev's
SECRET_KEY=change-me
