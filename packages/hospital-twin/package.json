{
  "name": "@ai-pass/hospital-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc --noCheck",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check:requirements": "tsx src/requirements-agents.ts",
    "check:stories": "tsx src/story-acceptance.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-pass/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
